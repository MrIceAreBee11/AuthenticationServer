# ============================================================
# Template konfigurasi. Salin menjadi .env lalu isi bagian RAHASIA.
#
# Sumber kebenaran daftar ini adalah src/config/env.schema.js. Setiap variabel
# di bawah divalidasi saat aplikasi start: tipenya dikonversi, rentangnya
# diperiksa, dan aplikasi MENOLAK MENYALA kalau ada yang salah. Seluruh masalah
# dilaporkan sekaligus, jadi berkas ini cukup diperbaiki satu putaran.
#
# Variabel yang punya nilai bawaan boleh dihapus dari .env Anda — bawaannya
# ada di skema. Yang ditandai WAJIB tidak punya bawaan.
# ============================================================


# ---------- Runtime ----------
NODE_ENV=development                  # WAJIB: development | test | staging | production
PORT=3000
APP_URL=http://localhost:3000         # WAJIB: dipakai menyusun tautan reset password
TRUST_PROXY=0                         # jumlah proxy di depan aplikasi; wajib > 0 di production
SHUTDOWN_TIMEOUT_MS=10000             # batas waktu menutup koneksi sebelum keluar paksa
JSON_BODY_LIMIT=10kb                  # batas ukuran body permintaan
LOG_LEVEL=info                        # error | warn | info | debug


# ---------- PostgreSQL ----------
DB_HOST=localhost                     # WAJIB (di dalam Docker: postgres)
DB_PORT=5432                          # WAJIB
DB_NAME=auth_service                  # WAJIB; database pengujian otomatis <nama>_test
DB_USER=                              # WAJIB
DB_PASSWORD=                          # WAJIB — RAHASIA
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_MS=10000


# ---------- Redis ----------
REDIS_HOST=localhost                  # WAJIB (di dalam Docker: redis)
REDIS_PORT=6379                       # WAJIB
REDIS_PASSWORD=                       # WAJIB — RAHASIA
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_READY_TIMEOUT_MS=3000
REDIS_RECONNECT_STEP_MS=250           # jeda naik bertahap per percobaan sambung ulang
REDIS_RECONNECT_MAX_MS=5000


# ---------- Token ----------
# JWT_SECRET minimal 32 karakter; aplikasi menolak menyala kalau lebih pendek.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=                           # WAJIB — RAHASIA
JWT_EXPIRES_IN=15m                    # WAJIB; format angka + s|m|h|d
REFRESH_TOKEN_EXPIRES_IN=7d           # WAJIB; harus lebih panjang dari JWT_EXPIRES_IN
OPAQUE_TOKEN_BYTES=32                 # panjang refresh token & token reset, minimal 32
JWT_ISSUER=auth-service               # klaim iss; diverifikasi saat token dibaca
JWT_AUDIENCE=auth-service-api         # klaim aud; diverifikasi saat token dibaca


# ---------- Kebijakan password ----------
# Keduanya boleh DIPERKETAT, tidak boleh dilemahkan: lantainya dipasang di skema.
PASSWORD_MIN_LENGTH=12                # minimal 12
BCRYPT_SALT_ROUNDS=12                 # 10-15; naikkan seiring perangkat makin cepat
PASSWORD_RESET_TTL_SECONDS=900        # 15 menit


# ---------- Pembatas laju ----------
# Angka-angka ini sengaja dapat diubah tanpa deploy — saat serangan
# credential-stuffing berjalan, batasnya perlu diperketat sekarang, bukan
# setelah build berikutnya selesai.
LOGIN_RATE_LIMIT_WINDOW_MS=900000     # 15 menit
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5       # hanya percobaan yang GAGAL yang dihitung
PASSWORD_RESET_WINDOW_MS=3600000      # 1 jam
PASSWORD_RESET_MAX_REQUESTS=3


# ---------- Cache izin ----------
PERMISSION_CACHE_TTL_SECONDS=300      # 5 menit


# ---------- Kunci idempotensi ----------
IDEMPOTENCY_TTL_SECONDS=86400         # 24 jam; berlaku untuk header Idempotency-Key


# ---------- Unggahan avatar ----------
AVATAR_MAX_SIZE_BYTES=2097152         # 2 MB
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AVATAR_URL_TTL_SECONDS=3600           # masa berlaku presigned URL


# ---------- Pembagian halaman ----------
USERS_DEFAULT_PAGE_SIZE=20
USERS_MAX_PAGE_SIZE=100               # batas atas ditentukan server, bukan klien


# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost               # WAJIB (di dalam Docker: rabbitmq)
RABBITMQ_PORT=5672                    # WAJIB
RABBITMQ_MANAGEMENT_PORT=15672        # hanya dipakai docker-compose, bukan aplikasi
RABBITMQ_USER=                        # WAJIB
RABBITMQ_PASSWORD=                    # WAJIB — RAHASIA


# ---------- MinIO ----------
MINIO_HOST=localhost                  # WAJIB (di dalam Docker: minio)
MINIO_PORT=9000                       # WAJIB
MINIO_CONSOLE_PORT=9001               # hanya dipakai docker-compose, bukan aplikasi
MINIO_ROOT_USER=                      # WAJIB
MINIO_ROOT_PASSWORD=                  # WAJIB — RAHASIA
MINIO_BUCKET=avatars                  # WAJIB
MINIO_USE_SSL=false                   # harus tepat "true" atau "false"


# ---------- SMTP ----------
SMTP_HOST=smtp.gmail.com              # WAJIB
SMTP_PORT=587                         # WAJIB
SMTP_SECURE=false                     # "true" untuk port 465
SMTP_USER=                            # WAJIB
SMTP_PASSWORD=                        # WAJIB — RAHASIA (Gmail: App Password, bukan password akun)
MAIL_FROM=                            # WAJIB, mis. "Auth Service <noreply@contoh.id>"


# ---------- Akun awal (dipakai seeder) ----------
SUPERADMIN_EMAIL=                     # WAJIB, harus format email yang sah
SUPERADMIN_PASSWORD=                  # WAJIB — RAHASIA, minimal 12 karakter
SUPERADMIN_FULL_NAME=                 # WAJIB, minimal 3 karakter
