# Nilai palsu untuk pengujian unit.
#
# Pengujian unit tidak menyentuh satu pun layanan: seluruh dependensi
# digantikan objek palsu yang disuntikkan lewat constructor. Berkas ini hanya
# ada supaya src/config/env.js lolos pemeriksaan "variabel wajib sudah diisi",
# yang berjalan saat modul dimuat.
#
# Tidak ada rahasia di sini, jadi berkas ini sengaja ikut di-commit — dengan
# begitu "npm run test:unit" langsung jalan di mesin yang baru meng-clone
# repositori ini, tanpa perlu .env maupun Docker.
NODE_ENV=test
PORT=3000
DB_HOST=tidak-dipakai
DB_PORT=5432
DB_NAME=tidak_dipakai
DB_USER=tidak-dipakai
DB_PASSWORD=tidak-dipakai
JWT_SECRET=kunci-palsu-khusus-pengujian-unit-minimal-32-karakter
JWT_EXPIRES_IN=1h
REDIS_HOST=tidak-dipakai
REDIS_PORT=6379
REDIS_PASSWORD=tidak-dipakai
APP_URL=http://localhost:3000
RABBITMQ_HOST=tidak-dipakai
RABBITMQ_PORT=5672
RABBITMQ_USER=tidak-dipakai
RABBITMQ_PASSWORD=tidak-dipakai
MINIO_HOST=tidak-dipakai
MINIO_PORT=9000
MINIO_ROOT_USER=tidak-dipakai
MINIO_ROOT_PASSWORD=tidak-dipakai
MINIO_BUCKET=tidak-dipakai
TRUST_PROXY=0
