{
  "name": "projectserverauth",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node --watch src/workers/emailWorker.js",
    "worker:start": "node src/workers/emailWorker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:permissions": "node scripts/generate-permissions.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --env-file=.env.unit --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --env-file=.env.test --test --test-concurrency=1 \"tests/*.e2e.test.js\"",
    "test:coverage": "node --env-file=.env.unit --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"src/infrastructure/**\" --test-coverage-lines=80 --test-coverage-branches=80 \"tests/unit/*.test.js\"",
    "test:db:setup": "sequelize-cli db:create --env test && sequelize-cli db:migrate --env test && sequelize-cli db:seed:all --env test",
    "test:db:drop": "sequelize-cli db:drop --env test",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "sequelize": "^6.37.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
