# Konfigurasi untuk CI. IKUT DI-COMMIT DENGAN SENGAJA.
#
# Tidak ada satu pun nilai rahasia di sini: layanan yang dituju dibuat baru
# setiap kali workflow berjalan dan dibuang ketika selesai. Nilai-nilai ini
# tidak pernah menyentuh lingkungan mana pun selain runner sekali pakai itu.
#
# Berkas ini disalin menjadi .env oleh workflow, lalu dipakai DUA pihak:
# docker compose (untuk merakit layanan) dan aplikasi (lewat src/config).
# Karena itu keduanya harus sepakat — misalnya REDIS_PASSWORD di sini adalah
# yang dipasang compose lewat --requirepass sekaligus yang dipakai klien.
#
# Hanya variabel yang TIDAK punya nilai bawaan di src/config/env.schema.js
# yang perlu ada di sini. Sisanya sengaja dibiarkan memakai bawaannya, supaya
# CI ikut membuktikan bahwa nilai bawaan itu memang benar.

NODE_ENV=test
APP_URL=http://localhost:3000
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_service
DB_USER=ci_user
DB_PASSWORD=ci_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ci_redis_password

# Panjangnya harus >= 32 karakter, sama seperti di lingkungan sungguhan.
JWT_SECRET=kunci-ci-sekali-pakai-yang-panjangnya-lebih-dari-32-karakter
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# RabbitMQ dan MinIO tidak dinyalakan di CI: tidak ada satu pun pengujian
# end-to-end yang menyentuh keduanya, dan container.connect() memang hanya
# mewajibkan database dan cache. Nilainya tetap harus ada karena skema config
# memvalidasi seluruh variabel saat boot, bukan hanya yang sedang dipakai.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ci_user
RABBITMQ_PASSWORD=ci_password
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ci_minio_user
MINIO_ROOT_PASSWORD=ci_minio_password
MINIO_BUCKET=avatars

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=ci@contoh.test
SMTP_PASSWORD=ci_password
MAIL_FROM=CI <ci@contoh.test>

SUPERADMIN_EMAIL=superadmin@contoh.test
SUPERADMIN_PASSWORD=PasswordCiPanjang123
SUPERADMIN_FULL_NAME=Superadmin CI
